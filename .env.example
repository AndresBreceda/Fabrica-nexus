# External APIs
GOOGLE_STITCH_API_KEY=

# PostgreSQL Database Configuration
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=fabrica_nexus

# Direct Database URL (optional, overrides discrete parameters)
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/fabrica_nexus

# Security & JWT Tokens
# Generate a strong key with: openssl rand -hex 32
SECRET_KEY=change-this-to-a-very-secure-random-secret-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Initial Admin / Seed User
FIRST_SUPERUSER_EMAIL=admin@fabrica-nexus.com
FIRST_SUPERUSER_PASSWORD=Admin123456!
FIRST_SUPERUSER_ROLE=admin